+
+  for(edge = edge_start + 1U; edge != edge_end; edge++) {
+    uint32_t edge_cycles = rx_edge_cycles[edge & LCDM_TJC_RX_EDGE_MASK];
+    if((int32_t)(edge_cycles - sample_cycles) > 0) {
+      break;
+    }
+    level = rx_edge_levels[edge & LCDM_TJC_RX_EDGE_MASK];
+  }
