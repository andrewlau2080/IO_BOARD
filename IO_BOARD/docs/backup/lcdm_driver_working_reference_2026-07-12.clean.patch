+                 "xstr %u,%u,%u,%u,0,%u,%u,1,1,1,\"%s\"",
+                 (unsigned int)x,
+                 (unsigned int)y,
+                 (unsigned int)w,
+                 (unsigned int)h,
+                 (unsigned int)font_color,
+                 (unsigned int)back_color,
+                 text);
