+static void cache_copy(char *cache, uint16_t cache_size, const char *text)
+{
+  if(cache_size == 0U) {
+    return;
+  }
+  if(text == 0) {
+    text = "";
+  }
+  (void)snprintf(cache, cache_size, "%s", text);
+}
+
+static uint8_t cache_text_equal(const char *cache, const char *text)
+{
+  if(text == 0) {
+    text = "";
+  }
+  return (strcmp(cache, text) == 0) ? 1U : 0U;
+}
+
+static void lcdm_set_text_cached(char *cache, uint16_t cache_size, const char *obj, const char *text)
+{
+  if(cache_text_equal(cache, text) != 0U) {
+    return;
+  }
+
+  lcdm_tjc_set_text(obj, (text == 0) ? "" : text);
+  cache_copy(cache, cache_size, text);
+}
+
